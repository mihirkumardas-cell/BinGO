# ============================================================
# CleanTrack AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (PostgreSQL + PostGIS) ──────────────────────────
DATABASE_URL=postgresql+asyncpg://cleantrack:cleantrack_pass@localhost:5432/cleantrack_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── S3 / MinIO Object Storage ────────────────────────────────
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_PHOTOS=cleantrack-photos
STORAGE_BUCKET_THUMBS=cleantrack-thumbs
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/cleantrack-photos

# ── AI Microservice ──────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_SECONDS=30

# ── Google Maps ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ── Firebase / FCM Push Notifications ────────────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# OR use base64-encoded JSON:
# FIREBASE_CREDENTIALS_BASE64=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsIC4uLn0=

# ── Twilio SMS Fallback ───────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ── AI Service Internal ──────────────────────────────────────
AI_APP_PORT=8001
YOLO_MODEL_PATH=./weights/cleantrack_yolov8n.pt
# Kaggle dataset reference (used during training, not inference):
# Dataset: https://www.kaggle.com/datasets/asdasdasasdas/garbage-classification
# TACO:    http://tacoDataset.org/
YOLO_CONFIDENCE_THRESHOLD=0.45
DEDUP_RADIUS_METERS=50
DEDUP_WINDOW_HOURS=72
HOTSPOT_RADIUS_METERS=200
HOTSPOT_MIN_REPORTS=3
HOTSPOT_WINDOW_DAYS=7

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
