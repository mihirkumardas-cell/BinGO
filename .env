# BinGO — Environment Variables
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=bingo_secret_key_983274982374982374982374982374982374982374982374
ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://localhost:3000,http://localhost:5173

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://cleantrack:cleantrack_pass@db:5432/cleantrack_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# S3 / MinIO Storage
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_PHOTOS=bingo-photos
STORAGE_BUCKET_THUMBS=bingo-thumbs
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/bingo-photos

# AI Microservice
AI_SERVICE_URL=http://ai_service:8001
AI_SERVICE_TIMEOUT_SECONDS=30

# AI Configuration
AI_APP_PORT=8001
YOLO_MODEL_PATH=./weights/cleantrack_yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
DEDUP_RADIUS_METERS=50
DEDUP_WINDOW_HOURS=72
HOTSPOT_RADIUS_METERS=200
HOTSPOT_MIN_REPORTS=3
HOTSPOT_WINDOW_DAYS=7

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
LOG_FORMAT=json
